<style>
:root {
  --navy:#101b36;
  --blue:#2457c5;
  --bg:#f2f4f8;
  --ink:#172033;
  --muted:#66718a;
  --green:#16804b;
  --red:#bd3434;
}
*{box-sizing:border-box}
body{margin:0;background:#eef2f8;color:var(--ink);font:15px/1.45 Arial,sans-serif}
header{background:linear-gradient(135deg,#101b36,#203d78);color:white;padding:26px 18px;text-align:center;box-shadow:0 4px 18px #101b3622}
header h1{margin:0 0 6px;font-size:clamp(23px,5vw,32px)}
header p{margin:0;color:#dce6ff}
main{max-width:1120px;margin:22px auto;padding:0 14px}
h2{margin:0 0 12px}
h3{margin:20px 0 9px}
.panel{box-shadow:0 5px 18px #1720330b;border:1px solid #e7ebf2}
.tabs{position:sticky;top:0;z-index:3;background:#eef2f8;padding:8px 0}
.tabs button{min-height:48px}
.panel.detail{border-top:4px solid var(--blue)}
.tabs,.subtabs{display:flex;gap:9px;margin-bottom:14px;flex-wrap:wrap}
button{border:0;border-radius:9px;padding:12px 15px;font-weight:bold;cursor:pointer}
.tabs button{flex:1;background:#dce2ed;font-size:16px}
.tabs button.active{background:var(--blue);color:white}
.panel{background:white;border-radius:15px;padding:18px;margin-bottom:14px}
.row{display:flex;gap:9px;flex-wrap:wrap}
input,select{padding:12px;border:1px solid #cbd3e0;border-radius:9px;font-size:15px;flex:1;min-width:150px}
.btn{background:#e9eef8;color:#24427d}
.primary{background:var(--blue);color:white}
.stats,.note{font-size:13px;color:var(--muted);margin:12px 0}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px}
.card{border:1px solid #e1e6ef;border-radius:12px;padding:13px;display:flex;gap:10px;align-items:center}
.dot{width:13px;height:13px;border-radius:50%;flex:none}
.cardinfo{flex:1;min-width:0}
.cardinfo strong{display:block;overflow-wrap:anywhere}
.small{font-size:12px;color:var(--muted);margin-top:4px}
.state{font-size:12px;font-weight:bold;margin-top:6px}
.good{color:var(--green)}
.bad{color:var(--red)}
.unknown{color:#986500}
.card button{padding:8px;background:#edf1f7}
.card button.done{background:#e0f4e8;color:#17653b}
.detail{display:none}
.detail.open{display:block}
.subtabs button{background:#e6ebf4}
.subtabs button.active{background:#263d70;color:white}
.hidden{display:none!important}
.stoplist{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:7px}
.stop{padding:9px;border:1px solid #e1e6ef;border-radius:8px;display:flex;gap:8px;align-items:center}
.stop button{margin-left:auto;background:#eaf0fb;color:#24427d}
.arrival{padding:9px;border-bottom:1px solid #e1e6ef;font-size:13px}
.line-summary{background:#f5f7fb;border:1px solid #e1e6ef;border-radius:10px;padding:12px;margin:10px 0}
.line-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid #dce3ee;background:#fff;border-radius:20px;padding:5px 9px;margin:3px;font-size:12px;font-weight:bold}
.line-chip .dot{width:9px;height:9px}
.station-extra{font-size:12px;color:var(--muted);margin-top:5px;line-height:1.5}
.stop{align-items:flex-start;flex-direction:column;background:#fff;box-shadow:0 2px 8px #17203308}
.stop-main{width:100%;min-width:0}
.stop-main strong{display:block;font-size:14px}
.stop-actions{display:flex;flex-direction:row;gap:5px;width:100%}
.stop-actions button{flex:1}
.arrival-live{width:100%;margin-top:8px;padding:9px 10px;border-radius:9px;background:#f0f6ff;border:1px solid #dce8fb}
.arrival-live-title{font-size:11px;font-weight:bold;color:#435779;text-transform:uppercase;letter-spacing:.3px;margin-bottom:4px}
.arrival-live-row{display:flex;justify-content:space-between;gap:8px;padding:4px 0;border-top:1px solid #dfe8f5;font-size:12px}
.arrival-live-row:first-of-type{border-top:0}
.arrival-live-time{font-weight:bold;color:#17653b;white-space:nowrap}
.arrival-live-empty{font-size:12px;color:var(--muted)}
.section-intro{color:var(--muted);font-size:13px;margin:-3px 0 13px}
.live-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin:12px 0}
.live-indicator{font-size:12px;color:var(--muted)}
.live-indicator:before{content:'●';color:#16804b;margin-right:6px}
.stoplist{grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}
@media(max-width:550px){header{padding:20px 12px}main{margin:12px auto}.tabs{gap:6px}.tabs button{font-size:14px;padding:10px 8px}.stoplist{grid-template-columns:1fr}}
.journey-option{border:1px solid #dce3ee;border-radius:12px;padding:13px;margin:12px 0;background:#fff}
.journey-head{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center}
.journey-total{font-size:18px;font-weight:bold;color:#18366f}
.journey-leg{border-left:4px solid #b9c5d8;margin:12px 0 12px 5px;padding:3px 0 5px 12px}
.journey-leg strong{display:block}
.journey-leg p{margin:5px 0;font-size:13px;line-height:1.45}
.journey-leg.walk{border-left-style:dashed;border-left-color:#8b96a8}
.journey-leg.transit{border-left-color:#2457c5}
.journey-meta{font-size:12px;color:var(--muted);margin-top:5px}
.journey-stops{background:#f5f7fb;border-radius:8px;padding:9px;margin-top:7px;font-size:12px;line-height:1.6}
.connection-title{font-size:12px;font-weight:bold;color:#45516a;margin-top:7px}
.progress{height:9px;background:#e7ebf2;border-radius:10px;overflow:hidden}
.progress span{display:block;height:100%;background:#2b9b62;width:0}
.modalback{position:fixed;inset:0;background:#08132999;display:none;align-items:center;justify-content:center;padding:14px;z-index:5}
.modalback.show{display:flex}
.modal{background:white;border-radius:15px;max-width:650px;width:100%;max-height:85vh;overflow:auto;padding:18px}
.footer{text-align:center;font-size:12px;color:var(--muted);padding:12px}
@media(max-width:550px){.panel{padding:13px}.row>*{min-width:100%}}

/* SIGNAL BOX 2.0 */
:root{--signal:#101b36;--signal2:#1d376c;--signalgreen:#20a464;--signalamber:#d69b25}
body{padding-bottom:82px}
header{position:relative;overflow:hidden;background:radial-gradient(circle at 85% 5%,#4268ae 0,transparent 34%),linear-gradient(135deg,#0b1429,#1c3972 72%,#14264c);text-align:left;padding:24px max(18px,calc((100vw - 1120px)/2))}
.header-inner{max-width:1120px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:16px}
.header-kicker{font-size:11px;letter-spacing:2px;color:#a9c5ff;font-weight:bold}
.header-title{font-size:clamp(24px,5vw,35px);font-weight:900;margin:5px 0}
.header-sub{font-size:13px;color:#dce6ff}
.header-live{border:1px solid #ffffff35;background:#ffffff12;border-radius:13px;padding:10px 13px;min-width:130px;text-align:center;font-size:12px}
.header-live b{display:block;color:#75e2a8;font-size:13px;margin-bottom:3px}
.signal-dashboard{background:linear-gradient(145deg,#111d39,#1a315d);color:#fff;border:1px solid #344a75;padding:18px}
.signal-top{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.signal-top h2{margin:0;color:#fff}
.signal-clock{font-size:12px;color:#b9c9e8}
.signal-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:16px 0}
.signal-stat{background:#ffffff0d;border:1px solid #ffffff18;border-radius:12px;padding:12px}
.signal-stat strong{display:block;font-size:25px;line-height:1.1}
.signal-stat span{display:block;color:#c3d0e8;font-size:11px;margin-top:5px}
.signal-stat.ok strong{color:#70dfa1}.signal-stat.warn strong{color:#ffd06c}.signal-stat.down strong{color:#ff8585}
.signal-bottom{display:grid;grid-template-columns:1.3fr 1fr;gap:12px}
.signal-subpanel{background:#ffffff0b;border:1px solid #ffffff18;border-radius:12px;padding:12px;min-width:0}
.signal-subpanel h3{margin:0 0 9px;font-size:13px;color:#dce7ff}
.network-pills{display:flex;flex-wrap:wrap;gap:7px}
.network-pill{display:flex;align-items:center;gap:6px;border:1px solid #ffffff2b;background:#ffffff0b;color:white;border-radius:8px;padding:7px 9px;font-size:11px;cursor:pointer}
.network-pill i{width:8px;height:8px;border-radius:50%;display:inline-block}
.network-pill small{color:#c5d2e9}
.quick-actions{display:flex;gap:8px;flex-wrap:wrap}
.quick-actions button{background:#ffffff16;border:1px solid #ffffff28;color:#fff;font-size:12px;padding:10px}
.quick-actions button:hover{background:#ffffff27}
.achievement-panel{border-left:4px solid #d6a83c}
.achievement-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.achievement-number{font-size:25px;font-weight:900;color:#9a6b00}
.achievement-lines{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}
.achievement-lines span{font-size:11px;border-radius:20px;padding:5px 9px;background:#edf1f7;color:#536078}
.achievement-lines span.done{background:#dcf5e7;color:#17653b;font-weight:bold}
.tabs{background:#eef2f8;z-index:4}
.tabs button{min-height:44px}
.mobile-nav{display:none}
.section-anchor{scroll-margin-top:78px}
#networkStatus{display:flex;align-items:center;gap:7px}
.signal-dot{width:8px;height:8px;background:#20a464;border-radius:50%;display:inline-block}
button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #8eb4ff;outline-offset:2px}
@media(max-width:700px){
 header{padding:18px 15px}.header-inner{align-items:flex-start}.header-live{min-width:95px;padding:8px;font-size:10px}.header-title{font-size:24px}.header-sub{font-size:12px}
 .signal-stats{grid-template-columns:repeat(2,1fr);gap:8px}.signal-stat{padding:10px}.signal-stat strong{font-size:22px}
 .signal-bottom{grid-template-columns:1fr}.signal-dashboard{padding:14px}
 .tabs{display:grid;grid-template-columns:1fr 1fr}.tabs button{font-size:13px;padding:10px 7px}
 main{padding:0 10px;margin:10px auto}.panel{border-radius:13px;padding:13px}
 .mobile-nav{position:fixed;z-index:20;bottom:0;left:0;right:0;display:grid;grid-template-columns:repeat(4,1fr);gap:3px;padding:7px 6px calc(7px + env(safe-area-inset-bottom));background:#101b36;border-top:1px solid #ffffff20;box-shadow:0 -5px 20px #101b3625}
 .mobile-nav button{background:transparent;color:#b9c7e1;border-radius:9px;padding:7px 2px;font-size:10px;display:flex;flex-direction:column;align-items:center;gap:3px}
 .mobile-nav button span{font-size:19px;line-height:1.1}.mobile-nav button.active{background:#29477f;color:white}
 body{padding-bottom:calc(75px + env(safe-area-inset-bottom))}
 .row{gap:7px}.row button{min-height:42px}
 .grid{grid-template-columns:1fr}.card{padding:11px}.card button{font-size:11px;padding:8px}
 .journey-option{padding:10px}.journey-total{font-size:16px}
 .modalback{padding:7px}.modal{max-height:88vh;padding:13px}
}
@media(min-width:701px){.signal-dashboard{margin-bottom:18px}}


/* SIGNAL BOX 3.0 — polished desktop + mobile */
:root{--ink:#17243c;--muted:#6c7890;--line:#e4eaf3;--accent:#2858bd}
body{background:#edf1f7;background-image:radial-gradient(#dbe3f0 0.7px,transparent 0.7px);background-size:18px 18px}
main{max-width:1220px}
.panel{box-shadow:0 10px 28px #14284b0b;border:1px solid #e4eaf3}
.section-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.section-heading h2{margin:2px 0 5px}.eyebrow{font-size:10px;font-weight:900;letter-spacing:1.8px;color:#5574ac}
.challenge-stamp{border:1px solid #e3c77d;background:#fff8df;color:#805c00;padding:8px 11px;border-radius:9px;font-size:11px;font-weight:900;letter-spacing:1px}
#nearbyMap{height:360px;border-radius:15px;border:1px solid #dce4ef;z-index:1;background:#e8edf3;overflow:hidden}
.nearby-toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:12px 0}.nearby-toolbar select{max-width:170px;flex:0 1 170px}
.nearby-layout{display:grid;grid-template-columns:1fr 1.1fr;gap:14px;margin-top:15px}.nearby-layout h3{margin:3px 0 9px}
.nearby-list{display:grid;gap:8px;max-height:420px;overflow:auto}.nearby-card{border:1px solid var(--line);border-radius:12px;padding:11px;background:#fff;display:flex;justify-content:space-between;gap:8px;align-items:center;cursor:pointer}.nearby-card.active{border-color:#6b91dc;box-shadow:0 0 0 2px #dce8ff}.nearby-card strong{display:block}.nearby-card small{color:var(--muted)}
.nearby-detail{border:1px solid var(--line);border-radius:12px;padding:13px;min-height:130px;background:#f9fbfe}.platform-group{border-top:1px solid #e5eaf2;padding:9px 0}.platform-name{font-size:12px;font-weight:900;color:#425575;margin-bottom:5px}.departure-row{display:flex;justify-content:space-between;gap:8px;padding:6px 0;font-size:13px}.departure-row b{color:#16804b;white-space:nowrap}.departure-row small{display:block;color:var(--muted)}
.challenge-box{display:flex;justify-content:space-between;align-items:center;gap:12px;background:linear-gradient(120deg,#101d3a,#234780);color:white;padding:17px;border-radius:14px;margin:12px 0}.challenge-label{font-size:10px;letter-spacing:1.6px;color:#afc7f6;font-weight:900}.challenge-destination{font-size:clamp(21px,4vw,29px);font-weight:900;margin-top:5px}.challenge-box .note{color:#d1def4;margin:4px 0 0}
.train-tracker{display:flex;gap:0;overflow-x:auto;padding:14px 5px 18px;align-items:flex-start}.tracker-stop{position:relative;flex:0 0 112px;text-align:center;font-size:11px;color:#4f5d75}.tracker-stop:before{content:'';position:absolute;height:4px;background:#b9c6d9;top:9px;left:0;right:0;z-index:0}.tracker-stop:first-child:before{left:50%}.tracker-stop:last-child:before{right:50%}.tracker-dot{position:relative;z-index:1;width:20px;height:20px;border:5px solid #fff;box-shadow:0 0 0 2px #6e86aa;background:#2457c5;border-radius:50%;margin:0 auto 8px}.tracker-stop.current .tracker-dot{background:#20a464;box-shadow:0 0 0 3px #bdebd1}.tracker-stop small{display:block;color:#758198;margin-top:4px}
.alert-center{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:9px}.alert-card{border:1px solid var(--line);border-left:4px solid #d5a12e;border-radius:10px;padding:11px;background:#fff}.alert-card.down{border-left-color:#c53b3b}.alert-card.good{border-left-color:#198a54}.alert-card strong{display:block}.alert-card p{font-size:12px;color:var(--muted);margin:5px 0 0}
.bus-timetable{margin-top:17px;padding:13px;border:1px solid #dce6f3;background:#f7faff;border-radius:12px}.timetable-row{display:grid;grid-template-columns:70px 1fr auto;gap:10px;padding:8px 0;border-bottom:1px solid #e2e9f3;font-size:13px}.timetable-row:last-child{border-bottom:0}.timetable-row b{color:#17653b}
@media(max-width:700px){
 body{background:#f0f3f8}.header-inner{align-items:center}.header-live{min-width:88px}.section-heading{align-items:flex-start}.section-heading>button{width:100%}
 #nearbyMap{height:290px}.nearby-layout{grid-template-columns:1fr}.nearby-list{max-height:300px}.nearby-toolbar>*{flex:1 1 100%;max-width:none!important}.challenge-box{align-items:stretch;flex-direction:column}.challenge-box button{width:100%}

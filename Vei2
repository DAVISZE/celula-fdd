function findNearby(){
 const status=$('geoStatus');
 if(!navigator.geolocation){status.textContent='Seu navegador não oferece geolocalização.';return;}
 status.textContent='Solicitando sua localização...';
 navigator.geolocation.getCurrentPosition(async pos=>{
  const lat=pos.coords.latitude,lon=pos.coords.longitude,radius=Number($('nearbyRadius').value||1500);
  initNearbyMap(); if(!nearbyMap){status.textContent='Mapa indisponível. Verifique a conexão.';return;}
  nearbyMap.setView([lat,lon],15);
  if(nearbyUserMarker)nearbyMap.removeLayer(nearbyUserMarker);
  nearbyUserMarker=L.circleMarker([lat,lon],{radius:9,color:'#fff',weight:3,fillColor:'#2867d8',fillOpacity:1}).addTo(nearbyMap).bindPopup('Você está aqui');
  status.textContent='Buscando estações e paradas próximas...';
  try{
   const data=await api('/StopPoint?lat='+lat+'&lon='+lon+'&stopTypes=NaptanMetroStation,NaptanRailStation,NaptanBusCoachStation&radius='+radius+'&useStopPointHierarchy=true');
   const list=(data.stopPoints||[]).filter(x=>x.lat&&x.lon).sort((a,b)=>distanceMeters(lat,lon,a.lat,a.lon)-distanceMeters(lat,lon,b.lat,b.lon)).slice(0,35);
   nearbyStops=list; drawNearby(list,lat,lon); status.textContent=list.length+' estações/paradas encontradas num raio de '+radius+' m.';
  }catch(e){status.textContent='Não foi possível buscar paradas próximas na TfL. Tente novamente.';}
 },err=>{status.textContent=err.code===1?'Permissão de localização negada. Ative a localização no navegador para usar o mapa.':'Não foi possível obter sua localização.';},{enableHighAccuracy:true,timeout:15000,maximumAge:60000});
}
function distanceMeters(a,b,c,d){const R=6371000,rad=x=>x*Math.PI/180;const x=rad(c-a),y=rad(d-b);const h=Math.sin(x/2)**2+Math.cos(rad(a))*Math.cos(rad(c))*Math.sin(y/2)**2;return 2*R*Math.asin(Math.sqrt(h));}
function drawNearby(list,lat,lon){
 nearbyMarkers.forEach(m=>nearbyMap.removeLayer(m));nearbyMarkers=[];$('nearbyList').innerHTML='';
 if(!list.length){$('nearbyList').textContent='Nenhuma estação encontrada neste raio.';return;}
 list.forEach((st,i)=>{
  const dist=Math.round(distanceMeters(lat,lon,st.lat,st.lon));
  const marker=L.marker([st.lat,st.lon]).addTo(nearbyMap).bindPopup('<b>'+escapeHtml(st.commonName||st.name)+'</b><br>'+dist+' m de distância');
  marker.on('click',()=>selectNearby(st));nearbyMarkers.push(marker);
  const card=document.createElement('button');card.className='nearby-card';card.innerHTML='<span><strong>'+escapeHtml(st.commonName||st.name)+'</strong><small>'+(st.modes||[]).join(' · ')+'</small></span><b>'+formatDistance(dist)+'</b>';
  card.onclick=()=>{nearbyMap.setView([st.lat,st.lon],17);marker.openPopup();selectNearby(st);document.querySelectorAll('.nearby-card').forEach(x=>x.classList.remove('active'));card.classList.add('active');};$('nearbyList').append(card);
 });
}
function formatDistance(m){return m>=1000?(m/1000).toFixed(1)+' km':m+' m';}
function escapeHtml(v){return String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

  const name=document.createElement('strong');name.textContent=st.commonName||st.name||st.id;
  const meta=document.createElement('small');meta.textContent=(st.modes||[]).join(' · ')+' '+(st.id?'· '+st.id:'');b.append(name,meta);
  b.onclick=()=>chooseAnnouncerStation(st);root.append(b);
 });
}
async function searchAnnouncerStations(){
 const q=$('announcerSearch').value.trim();if(q.length<2){$('announcerSearchResults').textContent='Digite pelo menos 2 letras.';return;}
 const token=++announcerSearchToken;$('announcerSearchResults').textContent='Pesquisando estações na TfL...';
 try{
  const data=await api('/StopPoint/Search?query='+encodeURIComponent(q)+'&modes=tube');
  if(token!==announcerSearchToken)return;
  const list=(data.matches||[]).filter(x=>x.id&&(!x.modes||x.modes.includes('tube')));
  renderAnnouncerSearchResults(list,'Nenhuma estação de metrô encontrada. Tente outro nome.');
 }catch(e){if(token===announcerSearchToken)$('announcerSearchResults').textContent='Não foi possível pesquisar agora. Verifique a conexão e tente novamente.';}
}
$('announcerSearch')?.addEventListener('keydown',e=>{if(e.key==='Enter')searchAnnouncerStations();});
async function chooseAnnouncerStation(st){
 stopAnnouncer();announcerStation=st;announcerPlatformId=null;
 $('announcerSelectedStation').classList.remove('hidden');$('announcerSelectedStation').textContent='Estação selecionada: '+(st.commonName||st.name);
 const sel=$('announcerPlatform');sel.disabled=true;sel.innerHTML='<option value="">Carregando plataformas...</option>';$('announcerLoadBtn').disabled=true;$('announcerStartBtn').disabled=true;
 $('announcerHero').innerHTML='<div class="announcer-status">ESTAÇÃO SELECIONADA</div><div class="announcer-count">— <small>min</small></div><div class="announcer-status">Carregando plataformas e serviços...</div>';
 try{
  const [detail,arr]=await Promise.all([api('/StopPoint/'+encodeURIComponent(st.id)),api('/StopPoint/'+encodeURIComponent(st.id)+'/Arrivals').catch(()=>[])]);
  // A TfL pode devolver o mesmo ponto várias vezes com nomes ligeiramente diferentes
  // (ex.: "Southfields station" e "Southfields underground station"). Agrupamos
  // pelo nome normalizado e consultamos todos os IDs do grupo, sem perder partidas.
  announcerPlatformSources={};
  const children=(detail.children||[]).filter(x=>x.id);
  const normalizePlatformName=name=>String(name||'').toLowerCase()
    .replace(/\bunderground\b/g,'').replace(/\bstation\b/g,'')
    .replace(/[^a-z0-9]+/g,' ').trim().replace(/\s+/g,' ');
  const grouped=new Map();
  children.forEach(x=>{
   const name=x.commonName||x.name||x.id, key=normalizePlatformName(name)||String(x.id);
   if(!grouped.has(key))grouped.set(key,{ids:[],name:name.replace(/\s+/g,' ').trim()});
   const g=grouped.get(key);if(!g.ids.includes(x.id))g.ids.push(x.id);
  });
  let options=[...grouped.entries()].map(([key,g],i)=>({id:'group:'+i,name:g.name,ids:g.ids}));
  if(!options.length){
   const arrivalGroups=new Map();
   (arr||[]).forEach(a=>{const name=a.platformName||'';if(!name)return;const key=normalizePlatformName(name)||name;if(!arrivalGroups.has(key))arrivalGroups.set(key,name);});
   options=[...arrivalGroups.entries()].map(([key,name],i)=>({id:'parent:'+st.id+':'+i,name,ids:[st.id],parentFilter:name}));
  }
  if(!options.length)options=[{id:'group:0',name:'Plataforma / partidas da estação (TfL)',ids:[st.id]}];
  options.forEach(o=>{announcerPlatformSources[o.id]=o;});
  sel.innerHTML='';options.forEach(o=>{const op=document.createElement('option');op.value=o.id;op.textContent=o.name;sel.append(op);});
  sel.disabled=false;$('announcerLoadBtn').disabled=false;
  $('announcerSelectedStation').textContent=(st.commonName||st.name)+' · '+options.length+' opção(ões) de plataforma/partida';
  loadAnnouncerPlatform();
 }catch(e){sel.innerHTML='<option value="">Falha ao carregar plataformas</option>';sel.disabled=true;$('announcerSelectedStation').textContent='Não foi possível carregar detalhes desta estação.';}
}
function selectedAnnouncerPlatform(){const sel=$('announcerPlatform');return sel.options[sel.selectedIndex]||null;}
async function loadAnnouncerPlatform(){
 if(!announcerStation)return;stopAnnouncer();const opt=selectedAnnouncerPlatform();if(!opt)return;
 announcerPlatformId=opt.value;$('announcerHero').innerHTML='<div class="announcer-status">CONSULTANDO PARTIDAS</div><div class="announcer-count">…</div><div class="announcer-status">Obtendo previsões de chegada da TfL.</div>';
 try{
  const source=announcerPlatformSources[announcerPlatformId]||{ids:[announcerStation.id]};
  const batches=await Promise.all((source.ids||[announcerStation.id]).map(id=>api('/StopPoint/'+encodeURIComponent(id)+'/Arrivals').catch(()=>[])));
  let arr=batches.flat();
  if(source.parentFilter)arr=arr.filter(a=>normalizeTfLPlatformLabel(a.platformName)===normalizeTfLPlatformLabel(source.parentFilter));
  const seen=new Set();arr=arr.filter(a=>{const k=a.id||[a.lineId,a.destinationName,a.expectedArrival,a.platformName].join('|');if(seen.has(k))return false;seen.add(k);return true;});
  announcerArrivals=arr.sort((a,b)=>(a.timeToStation||0)-(b.timeToStation||0));
  if(!announcerArrivals.length){$('announcerHero').innerHTML='<div class="announcer-status">SEM PREVISÕES DISPONÍVEIS</div><div class="announcer-count">—</div><div class="announcer-status">A TfL não forneceu partidas para esta plataforma neste momento. Tente outra plataforma.</div>';$('announcerStartBtn').disabled=true;return;}
  announcerLastArrivalKey=null;announcerLastMinute=null;
  $('announcerStartBtn').disabled=false;renderAnnouncerCountdown();
 }catch(e){$('announcerHero').innerHTML='<div class="announcer-status">ERRO AO CONSULTAR A TfL</div><div class="announcer-count">—</div><div class="announcer-status">Tente carregar as partidas novamente.</div>';}
}
function activeAnnouncerArrival(){return announcerArrivals.filter(a=>(a.timeToStation||0)>=0).sort((a,b)=>(a.timeToStation||0)-(b.timeToStation||0))[0]||null;}
function renderAnnouncerCountdown(){
 const a=activeAnnouncerArrival();if(!a){$('announcerHero').innerHTML='<div class="announcer-status">AGUARDANDO PRÓXIMA PREVISÃO</div><div class="announcer-count">—</div><div class="announcer-status">Atualize as partidas para consultar novamente.</div>';return;}
 const seconds=Math.max(0,Math.ceil((new Date(a.expectedArrival||Date.now()).getTime()-Date.now())/1000));
 const mins=Math.ceil(seconds/60);const line=a.lineName||a.modeName||'Linha não informada';const dest=a.destinationName||a.towards||'Destino não informado';
 $('announcerHero').innerHTML='<div class="announcer-status">PRÓXIMO TREM · '+escapeHtml(line.toUpperCase())+'</div><div class="announcer-count">'+(seconds<=25?'CHEGANDO':mins+' <small>minutos</small>')+'</div><div class="announcer-status">'+escapeHtml(dest)+' · '+escapeHtml(a.platformName||selectedAnnouncerPlatform()?.textContent||'Plataforma')+'</div><div class="announcer-status">'+(seconds<=60?'Aproxime-se da plataforma e tenha cuidado com o vão.':'Previsão TfL · contador atualizado a cada segundo')+'</div>';
 if(announcerRunning){
  const key=String(a.id||a.vehicleId||a.expectedArrival||dest);
  if(key!==announcerLastArrivalKey){announcerLastArrivalKey=key;announcerLastMinute=null;}
  if(mins<=5&&mins>1&&mins!==announcerLastMinute){announcerLastMinute=mins;speakAnnouncer('Seu trem está chegando em: '+mins+' minutos.');}
  if(mins===1&&announcerLastMinute!==1){announcerLastMinute=1;speakAnnouncer('Aproxime-se da plataforma e tenha cuidado com o vão.');}
 }
}
function speakAnnouncer(message){
 try{const Ctx=window.AudioContext||window.webkitAudioContext;if(Ctx){const ctx=new Ctx();[0,.18].forEach(t=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type='sine';o.frequency.value=880;o.connect(g);g.connect(ctx.destination);g.gain.setValueAtTime(.0001,ctx.currentTime+t);g.gain.exponentialRampToValueAtTime(.12,ctx.currentTime+t+.025);g.gain.exponentialRampToValueAtTime(.0001,ctx.currentTime+t+.12);o.start(ctx.currentTime+t);o.stop(ctx.currentTime+t+.13);});}}
 catch(e){}
 if('speechSynthesis'in window){window.speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(message);u.lang='pt-BR';u.rate=.94;u.pitch=1;window.speechSynthesis.speak(u);}
}
function testAnnouncerSound(){speakAnnouncer('Pim. Pim. Seu trem está chegando. Aproxime-se da plataforma e tenha cuidado com o vão.');}
async function acquireAnnouncerWakeLock(){
 if(!('wakeLock'in navigator)){$('announcerInfo').textContent='Este navegador não oferece Wake Lock. Mantenha o site aberto e ajuste o bloqueio automático do celular.';return;}
 try{announcerWakeLock=await navigator.wakeLock.request('screen');announcerWakeLock.addEventListener('release',()=>{announcerWakeLock=null;});$('announcerInfo').textContent='Tela ativa enquanto o navegador permitir. Se sair do site ou bloquear o celular, o sistema pode suspender os avisos.';}catch(e){$('announcerInfo').textContent='Não foi possível manter a tela ativa. Mantenha o site em primeiro plano.';}
}
function normalizeTfLPlatformLabel(name){return String(name||'').toLowerCase().replace(/\bunderground\b/g,'').replace(/\bstation\b/g,'').replace(/[^a-z0-9]+/g,' ').trim().replace(/\s+/g,' ');}
async function syncAnnouncerArrivals(){if(!announcerRunning||!announcerStation||!announcerPlatformId)return;try{const source=announcerPlatformSources[announcerPlatformId]||{ids:[announcerStation.id]};const batches=await Promise.all((source.ids||[announcerStation.id]).map(id=>api('/StopPoint/'+encodeURIComponent(id)+'/Arrivals').catch(()=>[])));let arr=batches.flat();if(source.parentFilter)arr=arr.filter(a=>normalizeTfLPlatformLabel(a.platformName)===normalizeTfLPlatformLabel(source.parentFilter));const seen=new Set();arr=arr.filter(a=>{const k=a.id||[a.lineId,a.destinationName,a.expectedArrival,a.platformName].join('|');if(seen.has(k))return false;seen.add(k);return true;});announcerArrivals=arr.sort((a,b)=>(a.timeToStation||0)-(b.timeToStation||0));}catch(e){}renderAnnouncerCountdown();}
async function startAnnouncer(){if(!announcerArrivals.length)return;announcerRunning=true;announcerLastMinute=null;await acquireAnnouncerWakeLock();renderAnnouncerCountdown();if(announcerTick)clearInterval(announcerTick);if(announcerSync)clearInterval(announcerSync);announcerTick=setInterval(renderAnnouncerCountdown,1000);announcerSync=setInterval(syncAnnouncerArrivals,25000);$('announcerStartBtn').textContent='▶ Avisos ativos';speakAnnouncer('Avisos de plataforma ativados.');}
function stopAnnouncer(){announcerRunning=false;if(announcerTick){clearInterval(announcerTick);announcerTick=null;}if(announcerSync){clearInterval(announcerSync);announcerSync=null;}if(announcerWakeLock){announcerWakeLock.release().catch(()=>{});announcerWakeLock=null;}if('speechSynthesis'in window)window.speechSynthesis.cancel();const b=$('announcerStartBtn');if(b)b.textContent='▶ Iniciar avisos';}
document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&announcerRunning)acquireAnnouncerWakeLock();});

// Start map only when the user opens the nearby section; geolocation is never requested automatically.

setInterval(()=>{const el=$('signalClock');if(el&&updatedAt){const age=Math.floor((Date.now()-updatedAt.getTime())/60000);if(age>0)el.textContent='Última consulta há '+age+' min';}},30000);
loadNetwork();
</script>

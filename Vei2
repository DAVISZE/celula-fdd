function cleanStationName(name){
 return String(name||'').toLowerCase().replace(/\bunderground\b/g,'').replace(/\bstation\b/g,'').replace(/\s+/g,' ').trim();
}
async function loadAllStations(force=false){
 const status=$('allStationsStatus');
 if(allTubeStations.length&&!force){filterAllStations();return;}
 status.textContent='Consultando a lista completa de estações da TfL...';$('allStationsList').innerHTML='';
 try{
  const raw=await api('/StopPoint/Mode/tube');
  const candidates=(Array.isArray(raw)?raw:[]).filter(x=>x&&x.id&&x.commonName&&(!x.stopType||/MetroStation/i.test(x.stopType)));
  const unique=new Map();
  candidates.forEach(st=>{const key=cleanStationName(st.commonName);if(!key)return;const old=unique.get(key);if(!old||(st.stopType==='NaptanMetroStation'&&old.stopType!=='NaptanMetroStation'))unique.set(key,st);});
  allTubeStations=[...unique.values()].sort((a,b)=>a.commonName.localeCompare(b.commonName,'en'));
  if(!allTubeStations.length)throw new Error('Lista vazia');
  status.textContent=allTubeStations.length+' estações encontradas. Pesquise ou selecione uma estação.';filterAllStations();
 }catch(e){status.textContent='Não foi possível carregar a lista completa agora. Tente novamente.';}

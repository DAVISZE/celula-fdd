<script>
const API='https://api.tfl.gov.uk';

const colors={
bakerloo:'#B36305',
central:'#E32017',
circle:'#FFD300',
district:'#00782A',
'hammersmith-city':'#F3A9BB',
jubilee:'#A0A5A9',
metropolitan:'#9B0056',
northern:'#000',
piccadilly:'#003688',
victoria:'#0098D4',
'waterloo-city':'#95CDBA'
};

let mode='tube';
let lines=[];
let statuses={};
let history=readHistory();
let selected=null;
let updatedAt=null;

const $=id=>document.getElementById(id);

async function api(path){
const r=await fetch(API+path);
if(!r.ok)throw new Error('Erro TfL '+r.status);
return r.json();
}

function lineColor(id){
return colors[String(id||'').toLowerCase()]||'#2457c5';
}

function addLineChip(parent,lineName,lineId,transportMode){
const chip=document.createElement('span');
chip.className='line-chip';
const dot=document.createElement('span');
dot.className='dot';
dot.style.background=lineColor(lineId);
const label=document.createElement('span');
label.textContent=(lineName||lineId||'Linha')+(transportMode==='bus'?' (ônibus)':'');
chip.append(dot,label);
parent.append(chip);
}

const interchangeCache=new Map();
let currentStops=[];
let arrivalRefreshTimer=null;
let refreshingArrivals=false;
let sequenceToken=0;

function stopArrivalTimer(){
 if(arrivalRefreshTimer){clearInterval(arrivalRefreshTimer);arrivalRefreshTimer=null;}
}

function arrivalMinutes(seconds){
 if(seconds<=25)return 'Chegando';
 return Math.ceil(seconds/60)+' min';
}

async function getLiveArrivals(stop){
 try{
  const arrivals=await api('/StopPoint/'+encodeURIComponent(stop.id)+'/Arrivals');
  const lineId=String(selected&&selected.id||'').toLowerCase();
  return arrivals.filter(a=>
   String(a.lineId||'').toLowerCase()===lineId ||
   String(a.lineName||'').toLowerCase()===lineId
  ).sort((a,b)=>(a.timeToStation||0)-(b.timeToStation||0)).slice(0,3);
 }catch(e){return null;}
}

async function renderStopArrivals(stop,box){
 const arrivals=await getLiveArrivals(stop);
 if(!box.isConnected)return;
 box.innerHTML='';
 const title=document.createElement('div');
 title.className='arrival-live-title';
 title.textContent='Próximas chegadas • '+(mode==='tube'?'esta linha':'esta rota');
 box.append(title);
 if(arrivals===null){
  const empty=document.createElement('div');empty.className='arrival-live-empty';
  empty.textContent='Previsão temporariamente indisponível.';box.append(empty);return;
 }
 if(!arrivals.length){
  const empty=document.createElement('div');empty.className='arrival-live-empty';
  empty.textContent='Nenhuma chegada prevista desta linha neste momento.';box.append(empty);return;
 }
 arrivals.forEach(a=>{
  const row=document.createElement('div');row.className='arrival-live-row';
  const destination=document.createElement('span');
  destination.textContent=(a.destinationName||a.towards||'Destino não informado')+(a.platformName?' • '+a.platformName:'');
  const time=document.createElement('span');time.className='arrival-live-time';
  time.textContent=arrivalMinutes(a.timeToStation||0);
  row.append(destination,time);box.append(row);
 });
}

async function refreshAllStationArrivals(){
 if(!selected||!currentStops.length||refreshingArrivals)return;
 refreshingArrivals=true;
 const selectedId=selected.id;
 $('liveStatus').textContent='Atualizando previsões...';
 try{
  for(let i=0;i<currentStops.length;i+=5){
   if(!selected||selected.id!==selectedId)break;
   await Promise.all(currentStops.slice(i,i+5).map(x=>renderStopArrivals(x.stop,x.box)));
  }
  if(selected&&selected.id===selectedId){
   $('liveStatus').textContent='Atualizado às '+new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',second:'2-digit'})+' • atualização automática a cada 45 segundos';
  }
 }finally{refreshingArrivals=false;}
}

async function getStopConnections(stop){
if(!stop||!stop.id)return [];
if(stop.lines&&stop.lines.length)return stop.lines;
if(interchangeCache.has(stop.id))return interchangeCache.get(stop.id);
const pending=api('/StopPoint/'+encodeURIComponent(stop.id))
.then(data=>data.lines||[])
.catch(()=>[]);
interchangeCache.set(stop.id,pending);
return pending;
}

function readHistory(){
try{
return JSON.parse(localStorage.getItem('londonTransitHistory')||'{}');
}catch{
return {};
}
}

function saveHistory(){
localStorage.setItem('londonTransitHistory',JSON.stringify(history));
updateProgress();
}

function setMode(m){
mode=m;
selected=null;
$('tubeTab').classList.toggle('active',m==='tube');
$('busTab').classList.toggle('active',m==='bus');
$('search').value='';
$('detail').classList.remove('open');
loadNetwork();
}


function goTo(id,button){
 const el=$(id);if(id==='allStationsSection')loadAllStations();if(el)el.scrollIntoView({behavior:'smooth',block:'start'}); if(id==='nearbySection'&&nearbyMap){setTimeout(()=>nearbyMap.invalidateSize(),250);}
 document.querySelectorAll('.mobile-nav button').forEach(b=>b.classList.toggle('active',b===button));
}
function updateSignalPanel(){
 const total=lines.length;
 let good=0,warn=0,down=0;
 lines.forEach(line=>{
  const arr=statuses[line.id]||[];
  if(!arr.length){warn++;return;}
  const worst=Math.min(...arr.map(x=>Number(x.statusSeverity??10)));
  if(worst===10)good++;else if(worst<=5)down++;else warn++;
 });
 $('statLines').textContent=total;
 $('statGood').textContent=good;
 $('statWarn').textContent=warn;
 $('statDown').textContent=down;
 $('signalClock').textContent=updatedAt?'Última consulta: '+updatedAt.toLocaleTimeString():'Aguardando dados da TfL';
 $('headerUpdated').textContent=updatedAt?'Atualizado '+updatedAt.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}):'Aguardando TfL...';
 const root=$('networkPills');root.innerHTML='';
 lines.forEach(line=>{
  const b=document.createElement('button');b.className='network-pill';
  const dot=document.createElement('i');dot.style.background=mode==='tube'?lineColor(line.id):'#4b8de8';
  const name=document.createElement('span');name.textContent=line.name;
  const status=document.createElement('small');status.textContent=severityClass(line.id)==='good'?'NORMAL':statusText(line.id).slice(0,22).toUpperCase();
  b.append(dot,name,status);b.onclick=()=>openLine(line);root.append(b);
 });
 updateAchievement();
}
function updateAchievement(){
 const tubeIds=['bakerloo','central','circle','district','hammersmith-city','jubilee','metropolitan','northern','piccadilly','victoria','waterloo-city'];
 const tubeNames=['Bakerloo','Central','Circle','District','Hammersmith & City','Jubilee','Metropolitan','Northern','Piccadilly','Victoria','Waterloo & City'];
 const used=tubeIds.filter(id=>history['tube:'+id]);
 $('tubeAchievement').textContent=used.length+'/11';
 const root=$('achievementLines');root.innerHTML='';
 tubeNames.forEach((name,i)=>{
  const id=tubeIds[i],tag=document.createElement('span');
  const done=!!history['tube:'+id];tag.className=done?'done':'';
  tag.textContent=(done?'✓ ':'○ ')+name;root.append(tag);
 });
}

async function loadNetwork(){
$('networkStatus').textContent='Carregando linhas e situação atual...';
$('lineList').innerHTML='';

try{
const [l,s]=await Promise.all([
api('/Line/Mode/'+mode),
api('/Line/Mode/'+mode+'/Status')
]);

lines=l;
statuses={};

s.forEach(x=>statuses[x.id]=x.lineStatuses||[]);

updatedAt=new Date();
renderLines();
updateSignalPanel();

$('networkStatus').textContent=
lines.length+' linhas carregadas • Atualizado às '+updatedAt.toLocaleTimeString();

}catch(e){
$('networkStatus').textContent=
'Não foi possível consultar a TfL. Verifique a internet.';
}
}

function statusText(id){
const arr=statuses[id]||[];
if(!arr.length)return 'Estado não informado';
return arr.map(x=>x.statusSeverityDescription||'Estado não informado').join(' · ');
}

function severityClass(id){
const arr=statuses[id]||[];
if(!arr.length)return 'unknown';
return arr.every(x=>x.statusSeverity===10)?'good':'bad';
}

function renderLines(){
const q=$('search').value.toLowerCase().trim();
const root=$('lineList');
root.innerHTML='';

const found=lines.filter(x=>
(x.name+' '+x.id).toLowerCase().includes(q)
);

found.forEach(line=>{
const card=document.createElement('div');
card.className='card';

const dot=document.createElement('span');
dot.className='dot';
dot.style.background=mode==='tube'?(colors[line.id]||'#2457c5'):'#2457c5';

const info=document.createElement('div');
info.className='cardinfo';

const name=document.createElement('strong');
name.textContent=line.name;

const code=document.createElement('div');
code.className='small';
code.textContent='Código: '+line.id;

const st=document.createElement('div');
st.className='state '+severityClass(line.id);
st.textContent='● '+statusText(line.id);

info.append(name,code,st);

const open=document.createElement('button');
open.textContent='Detalhes';
open.onclick=()=>openLine(line);

const done=document.createElement('button');
done.className=history[mode+':'+line.id]?'done':'';
done.textContent=history[mode+':'+line.id]?'✓ Já usei':'+ Já usei';
done.onclick=()=>toggleHistory(line);

card.append(dot,info,done,open);
root.append(card);
});

if(!found.length){
root.innerHTML='<div>Nenhuma linha encontrada.</div>';
}

updateProgress();
}

function toggleHistory(line){
const k=mode+':'+line.id;

if(history[k])delete history[k];
else history[k]={
name:line.name,
mode:mode,
markedAt:new Date().toISOString()
};

saveHistory();
renderLines();
}

function updateProgress(){
const count=Object.keys(history).length;

$('progressText').textContent=
count+' linha(s)/rota(s) marcadas no seu histórico';

$('progressBar').style.width=
Math.min(100,count/Math.max(lines.length,1)*100)+'%';

updateAchievement();
$('historyInfo').textContent=
Object.values(history).map(x=>x.name+' ('+x.mode+')').join(' • ')
||'Você ainda não marcou nenhuma linha.';
}

async function openLine(line){
stopArrivalTimer();
currentStops=[];
sequenceToken++;
selected=line;
$('detail').classList.add('open');
$('detailTitle').textContent=line.name;
$('detailMeta').textContent=
(mode==='tube'?'London Underground':'London bus')+' • '+line.id;

$('detailStatus').textContent='Situação: '+statusText(line.id);
$('branches').textContent='Buscando trajetos...';
$('overviewInfo').textContent='Carregando...';
$('lineConnections').textContent='Carregando estações e conexões...';
$('stops').innerHTML='';
$('disruptions').textContent='Buscando alertas...';

showDetailTab('overview');
$('detail').scrollIntoView({behavior:'smooth'});

try{
const [routes,dis]=await Promise.all([
api('/Line/'+encodeURIComponent(line.id)+'/Route'),
api('/Line/'+encodeURIComponent(line.id)+'/Disruption')
]);

$('branches').innerHTML='';

if(routes.length){
routes.forEach(r=>{
const p=document.createElement('p');
p.textContent=(r.routeSections||[])
.map(x=>x.origin+' → '+x.destination)
.filter(Boolean).join(' | ')||'Trajeto disponível na TfL';
$('branches').append(p);
});
}else{
$('branches').textContent='Trajetos não disponíveis.';
}

$('overviewInfo').textContent=
'Nome: '+line.name+
'. Identificador TfL: '+line.id+
'. Situação atual: '+statusText(line.id)+
'. A lista de estações/paradas e as conexões com outros serviços aparece na aba correspondente.';

$('disruptions').innerHTML='';

if(dis.length){
dis.forEach(d=>{
const box=document.createElement('div');
box.className='arrival';
box.textContent=(d.category||'Aviso')+': '+
(d.description||d.additionalInfo||d.comments||'Detalhes não fornecidos');
$('disruptions').append(box);
});
}else{
$('disruptions').textContent='Nenhum alerta específico retornado.';
}

}catch(e){
$('branches').textContent='Detalhes indisponíveis no momento.';
$('disruptions').textContent='Alertas indisponíveis.';
}

loadSequence();
}

function showDetailTab(tab){
document.querySelectorAll('.subtabs button').forEach(b=>
b.classList.toggle('active',b.dataset.view===tab)
);

['overview','stops','disruptions'].forEach(x=>
$('view-'+x).classList.toggle('hidden',x!==tab)
);
}

function closeDetail(){
$('detail').classList.remove('open');
selected=null;
currentStops=[];
stopArrivalTimer();
}

async function loadSequence(){
if(!selected)return;

const dir=$('direction').value;
sequenceToken++;
stopArrivalTimer();
currentStops=[];
$('liveStatus').textContent='Carregando estações e previsões...';
$('stops').textContent='Carregando paradas...';

try{

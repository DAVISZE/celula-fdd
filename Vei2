async function planJourney(){
const from=$('from').value.trim();
const to=$('to').value.trim();
if(!from||!to){
$('journeyResult').textContent='Digite origem e destino.';
return;
}
$('journeyResult').textContent='Calculando o melhor trajeto...';
try{
const data=await api('/Journey/JourneyResults/'+encodeURIComponent(from)+'/to/'+encodeURIComponent(to));
const root=$('journeyResult');
root.innerHTML='';
const journeys=(data.journeys||[]).slice(0,5);
if(!journeys.length){
root.textContent='Nenhuma opção encontrada. Tente usar o nome oficial da estação ou parada.';
return;
}
journeys.forEach((j,i)=>{
const box=document.createElement('article');
box.className='journey-option';
const head=document.createElement('div');
head.className='journey-head';
const title=document.createElement('strong');
title.textContent='Opção '+(i+1);
const total=document.createElement('span');
total.className='journey-total';
total.textContent=(j.duration??'?')+' min';
head.append(title,total);
box.append(head);

const legs=j.legs||[];
const transitCount=legs.filter(l=>l.mode&&l.mode.name&&l.mode.name.toLowerCase()!=='walking').length;
const summary=document.createElement('div');
summary.className='journey-meta';
summary.textContent=legs.length+' etapas • '+Math.max(0,transitCount-1)+' troca(s) aproximada(s)';
box.append(summary);

legs.forEach((leg,index)=>{
const modeName=(leg.mode&&leg.mode.name)||'Trecho';
const isWalk=modeName.toLowerCase()==='walking';
const option=leg.routeOptions&&leg.routeOptions[0]||{};
const lineName=option.name||option.lineIdentifier||'';
const fromName=leg.departurePoint&&leg.departurePoint.commonName||'Ponto de partida';
const toName=leg.arrivalPoint&&leg.arrivalPoint.commonName||'Ponto de chegada';
const section=document.createElement('div');
section.className='journey-leg '+(isWalk?'walk':'transit');
const strong=document.createElement('strong');
strong.textContent=(index+1)+'. '+(isWalk?'🚶 Caminhada':(modeName==='bus'?'🚌 Ônibus':'🚇 '+modeName))+(lineName?' • '+lineName:'');
section.append(strong);
const route=document.createElement('p');
route.textContent=fromName+' → '+toName;
section.append(route);

const instruction=leg.instruction||{};
if(instruction.summary||instruction.detailed){
const detail=document.createElement('p');
detail.textContent=instruction.summary||instruction.detailed;
section.append(detail);
}
const duration=document.createElement('div');
duration.className='journey-meta';
duration.textContent=(leg.duration!=null?leg.duration+' min':'')+
(leg.departureTime?' • Saída '+leg.departureTime:'')+
(leg.arrivalTime?' • Chegada '+leg.arrivalTime:'');
section.append(duration);

const pathStops=leg.path&&leg.path.stopPoints||[];
if(pathStops.length){
const stopBox=document.createElement('div');
stopBox.className='journey-stops';
const label=document.createElement('strong');
label.textContent='Estações/paradas neste trecho: ';
stopBox.append(label);
const names=pathStops.map(s=>s.name||s.commonName).filter(Boolean);
const list=document.createElement('span');
list.textContent=names.length?names.join(' → '):'Detalhes não fornecidos pela TfL';
stopBox.append(list);
section.append(stopBox);
}
box.append(section);
});
const footer=document.createElement('div');
footer.className='journey-meta';
footer.textContent='Etapas, linhas e conexões exibidas conforme os dados retornados pela TfL.';
box.append(footer);
root.append(box);
});
}catch(e){
$('journeyResult').textContent='Não foi possível calcular o trajeto agora. Confira os nomes dos locais e tente novamente.';
}
}


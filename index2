<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>London Transit Explorer</title>
<style>
:root {
  --navy:#101b36;
  --blue:#2457c5;
  --bg:#f2f4f8;
  --ink:#172033;
  --muted:#66718a;
  --green:#16804b;
  --red:#bd3434;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px Arial}
header{background:var(--navy);color:white;padding:23px;text-align:center}
main{max-width:1100px;margin:20px auto;padding:0 14px}
.tabs,.subtabs{display:flex;gap:9px;margin-bottom:14px;flex-wrap:wrap}
button{border:0;border-radius:9px;padding:12px 15px;font-weight:bold;cursor:pointer}
.tabs button{flex:1;background:#dce2ed;font-size:16px}
.tabs button.active{background:var(--blue);color:white}
.panel{background:white;border-radius:15px;padding:18px;margin-bottom:14px}
.row{display:flex;gap:9px;flex-wrap:wrap}
input,select{padding:12px;border:1px solid #cbd3e0;border-radius:9px;font-size:15px;flex:1;min-width:150px}
.btn{background:#e9eef8;color:#24427d}
.primary{background:var(--blue);color:white}
.stats,.note{font-size:13px;color:var(--muted);margin:12px 0}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px}
.card{border:1px solid #e1e6ef;border-radius:12px;padding:13px;display:flex;gap:10px;align-items:center}
.dot{width:13px;height:13px;border-radius:50%;flex:none}
.cardinfo{flex:1;min-width:0}
.cardinfo strong{display:block;overflow-wrap:anywhere}
.small{font-size:12px;color:var(--muted);margin-top:4px}
.state{font-size:12px;font-weight:bold;margin-top:6px}
.good{color:var(--green)}
.bad{color:var(--red)}
.unknown{color:#986500}
.card button{padding:8px;background:#edf1f7}
.card button.done{background:#e0f4e8;color:#17653b}
.detail{display:none}
.detail.open{display:block}
.subtabs button{background:#e6ebf4}
.subtabs button.active{background:#263d70;color:white}
.hidden{display:none!important}
.stoplist{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:7px}
.stop{padding:9px;border:1px solid #e1e6ef;border-radius:8px;display:flex;gap:8px;align-items:center}
.stop button{margin-left:auto;background:#eaf0fb;color:#24427d}
.arrival{padding:9px;border-bottom:1px solid #e1e6ef;font-size:13px}
.progress{height:9px;background:#e7ebf2;border-radius:10px;overflow:hidden}
.progress span{display:block;height:100%;background:#2b9b62;width:0}
.modalback{position:fixed;inset:0;background:#08132999;display:none;align-items:center;justify-content:center;padding:14px;z-index:5}
.modalback.show{display:flex}
.modal{background:white;border-radius:15px;max-width:650px;width:100%;max-height:85vh;overflow:auto;padding:18px}
.footer{text-align:center;font-size:12px;color:var(--muted);padding:12px}
@media(max-width:550px){.panel{padding:13px}.row>*{min-width:100%}}
</style>
</head>
<body>

<header>
<h1>🚇 London Transit Explorer</h1>
<p>Guia de metrô e ônibus de Londres</p>
</header>

<main>

<div class="tabs">
<button id="tubeTab" class="active" onclick="setMode('tube')">🚇 METRÔ</button>
<button id="busTab" onclick="setMode('bus')">🚌 ÔNIBUS</button>
</div>

<section class="panel">
<div class="row">
<input id="search" placeholder="Pesquisar linha (ex.: Central ou 39)" oninput="renderLines()">
<button class="btn" onclick="loadNetwork()">↻ Atualizar</button>
</div>
<div class="stats" id="networkStatus">Carregando...</div>
<div class="grid" id="lineList"></div>
</section>

<section class="panel detail" id="detail">
<div class="row">
<div>
<h2 id="detailTitle">Detalhes</h2>
<div id="detailMeta"></div>
</div>
<button onclick="closeDetail()">Fechar ✕</button>
</div>

<div id="detailStatus" class="note"></div>

<div class="subtabs">
<button class="active" data-view="overview" onclick="showDetailTab('overview')">Visão geral</button>
<button data-view="stops" onclick="showDetailTab('stops')">Estações / paradas</button>
<button data-view="disruptions" onclick="showDetailTab('disruptions')">Alertas</button>
</div>

<div id="view-overview">
<h3>Trajetos e direções</h3>
<div id="branches" class="note">Carregando...</div>
<h3>Informações</h3>
<div id="overviewInfo" class="note"></div>
</div>

<div id="view-stops" class="hidden">
<div class="row">
<select id="direction" onchange="loadSequence()">
<option value="outbound">Ida</option>
<option value="inbound">Volta</option>
</select>
<button class="btn" onclick="loadSequence()">Carregar paradas</button>
</div>
<div id="stops" class="stoplist"></div>
</div>

<div id="view-disruptions" class="hidden">
<div id="disruptions"></div>
</div>
</section>

<section class="panel">
<h2>🧭 Planejar uma viagem</h2>
<p class="note">Pesquise um trajeto entre dois locais de Londres.</p>
<div class="row">
<input id="from" placeholder="De onde? Ex.: King's Cross">
<input id="to" placeholder="Para onde? Ex.: Oxford Circus">
<button class="btn primary" onclick="planJourney()">Encontrar trajeto</button>
</div>
<div id="journeyResult" class="note"></div>
</section>

<section class="panel">
<h2>🏅 Meu histórico</h2>
<div class="stats" id="progressText"></div>
<div class="progress"><span id="progressBar"></span></div>
<p class="note">Marque as linhas que você já utilizou.</p>
<div class="row">
<button class="btn primary" onclick="exportLon()">Exportar .LON</button>
<button class="btn" onclick="document.getElementById('importFile').click()">Importar .LON</button>
<input id="importFile" type="file" accept=".lon,.json" hidden onchange="importLon(event)">
</div>
<div id="historyInfo" class="stats"></div>
</section>

<div class="footer">
Dados fornecidos pela Transport for London (TfL).
Aplicação independente, não oficial.
</div>
</main>

<div class="modalback" id="arrivalModal" onclick="if(event.target===this)closeModal()">
<div class="modal">
<div class="row">
<h2 id="arrivalTitle">Próximas chegadas</h2>
<button onclick="closeModal()">Fechar ✕</button>
</div>
<div id="arrivalContent"></div>
</div>
</div>

<script>
const API='https://api.tfl.gov.uk';

const colors={
bakerloo:'#B36305',
central:'#E32017',
circle:'#FFD300',
district:'#00782A',
'hammersmith-city':'#F3A9BB',
jubilee:'#A0A5A9',
metropolitan:'#9B0056',
northern:'#000',
piccadilly:'#003688',
victoria:'#0098D4',
'waterloo-city':'#95CDBA'
};

let mode='tube';
let lines=[];
let statuses={};
let history=readHistory();
let selected=null;
let updatedAt=null;

const $=id=>document.getElementById(id);

async function api(path){
const r=await fetch(API+path);
if(!r.ok)throw new Error('Erro TfL '+r.status);
return r.json();
}

function readHistory(){
try{
return JSON.parse(localStorage.getItem('londonTransitHistory')||'{}');
}catch{
return {};
}
}

function saveHistory(){
localStorage.setItem('londonTransitHistory',JSON.stringify(history));
updateProgress();
}

function setMode(m){
mode=m;
selected=null;
$('tubeTab').classList.toggle('active',m==='tube');
$('busTab').classList.toggle('active',m==='bus');
$('search').value='';
$('detail').classList.remove('open');
loadNetwork();
}

async function loadNetwork(){
$('networkStatus').textContent='Carregando linhas e situação atual...';
$('lineList').innerHTML='';

try{
const [l,s]=await Promise.all([
api('/Line/Mode/'+mode),
api('/Line/Mode/'+mode+'/Status')
]);

lines=l;
statuses={};

s.forEach(x=>statuses[x.id]=x.lineStatuses||[]);

updatedAt=new Date();
renderLines();

$('networkStatus').textContent=
lines.length+' linhas carregadas • Atualizado às '+updatedAt.toLocaleTimeString();

}catch(e){
$('networkStatus').textContent=
'Não foi possível consultar a TfL. Verifique a internet.';
}
}

function statusText(id){
const arr=statuses[id]||[];
if(!arr.length)return 'Estado não informado';
return arr.map(x=>x.statusSeverityDescription||'Estado não informado').join(' · ');
}

function severityClass(id){
const arr=statuses[id]||[];
if(!arr.length)return 'unknown';
return arr.every(x=>x.statusSeverity===10)?'good':'bad';
}

function renderLines(){
const q=$('search').value.toLowerCase().trim();
const root=$('lineList');
root.innerHTML='';

const found=lines.filter(x=>
(x.name+' '+x.id).toLowerCase().includes(q)
);

found.forEach(line=>{
const card=document.createElement('div');
card.className='card';

const dot=document.createElement('span');
dot.className='dot';
dot.style.background=mode==='tube'?(colors[line.id]||'#2457c5'):'#2457c5';

const info=document.createElement('div');
info.className='cardinfo';

const name=document.createElement('strong');
name.textContent=line.name;

const code=document.createElement('div');
code.className='small';
code.textContent='Código: '+line.id;

const st=document.createElement('div');
st.className='state '+severityClass(line.id);
st.textContent='● '+statusText(line.id);

info.append(name,code,st);

const open=document.createElement('button');
open.textContent='Detalhes';
open.onclick=()=>openLine(line);

const done=document.createElement('button');
done.className=history[mode+':'+line.id]?'done':'';
done.textContent=history[mode+':'+line.id]?'✓ Já usei':'+ Já usei';
done.onclick=()=>toggleHistory(line);

card.append(dot,info,done,open);
root.append(card);
});

if(!found.length){
root.innerHTML='<div>Nenhuma linha encontrada.</div>';
}

updateProgress();
}

function toggleHistory(line){
const k=mode+':'+line.id;

if(history[k])delete history[k];
else history[k]={
name:line.name,
mode:mode,
markedAt:new Date().toISOString()
};

saveHistory();
renderLines();
}

function updateProgress(){
const count=Object.keys(history).length;

$('progressText').textContent=
count+' linha(s)/rota(s) marcadas no seu histórico';

$('progressBar').style.width=
Math.min(100,count/Math.max(lines.length,1)*100)+'%';

$('historyInfo').textContent=
Object.values(history).map(x=>x.name+' ('+x.mode+')').join(' • ')
||'Você ainda não marcou nenhuma linha.';
}

async function openLine(line){
selected=line;
$('detail').classList.add('open');
$('detailTitle').textContent=line.name;
$('detailMeta').textContent=
(mode==='tube'?'London Underground':'London bus')+' • '+line.id;

$('detailStatus').textContent='Situação: '+statusText(line.id);
$('branches').textContent='Buscando trajetos...';
$('overviewInfo').textContent='Carregando...';
$('stops').innerHTML='';
$('disruptions').textContent='Buscando alertas...';

showDetailTab('overview');
$('detail').scrollIntoView({behavior:'smooth'});

try{
const [routes,dis]=await Promise.all([
api('/Line/'+encodeURIComponent(line.id)+'/Route'),
api('/Line/'+encodeURIComponent(line.id)+'/Disruption')
]);

$('branches').innerHTML='';

if(routes.length){
routes.forEach(r=>{
const p=document.createElement('p');
p.textContent=(r.routeSections||[])
.map(x=>x.origin+' → '+x.destination)
.filter(Boolean).join(' | ')||'Trajeto disponível na TfL';
$('branches').append(p);
});
}else{
$('branches').textContent='Trajetos não disponíveis.';
}

$('overviewInfo').textContent=
'Nome: '+line.name+
'. Identificador TfL: '+line.id+
'. Consulte as abas de estações/paradas e alertas para mais detalhes.';

$('disruptions').innerHTML='';

if(dis.length){
dis.forEach(d=>{
const box=document.createElement('div');
box.className='arrival';
box.textContent=(d.category||'Aviso')+': '+
(d.description||d.additionalInfo||d.comments||'Detalhes não fornecidos');
$('disruptions').append(box);
});
}else{
$('disruptions').textContent='Nenhum alerta específico retornado.';
}

}catch(e){
$('branches').textContent='Detalhes indisponíveis no momento.';
$('disruptions').textContent='Alertas indisponíveis.';
}

loadSequence();
}

function showDetailTab(tab){
document.querySelectorAll('.subtabs button').forEach(b=>
b.classList.toggle('active',b.dataset.view===tab)
);

['overview','stops','disruptions'].forEach(x=>
$('view-'+x).classList.toggle('hidden',x!==tab)
);
}

function closeDetail(){
$('detail').classList.remove('open');
selected=null;
}

async function loadSequence(){
if(!selected)return;

const dir=$('direction').value;
$('stops').textContent='Carregando paradas...';

try{
const data=await api(
'/Line/'+encodeURIComponent(selected.id)+'/Route/Sequence/'+dir
);

const root=$('stops');
root.innerHTML='';

let stops=[];
(data.stopPointSequences||[]).forEach(seq=>
(seq.stopPoint||[]).forEach(s=>stops.push(s))
);

const seen=new Set();
stops=stops.filter(s=>{
if(seen.has(s.id))return false;
seen.add(s.id);
return true;
});

if(!stops.length){
root.textContent='Paradas não disponíveis.';
return;
}

stops.forEach((s,i)=>{
const el=document.createElement('div');
el.className='stop';

const label=document.createElement('span');
label.textContent=(i+1)+'. '+s.name;

const btn=document.createElement('button');
btn.textContent='Chegadas';
btn.onclick=()=>showArrivals(s);

el.append(label,btn);
root.append(el);
});

}catch(e){
$('stops').textContent='Não foi possível carregar as paradas.';
}
}

async function showArrivals(stop){
$('arrivalModal').classList.add('show');
$('arrivalTitle').textContent='Chegadas: '+stop.name;
$('arrivalContent').textContent='Consultando...';

try{
const arr=await api(
'/StopPoint/'+encodeURIComponent(stop.id)+'/Arrivals'
);

arr.sort((a,b)=>a.timeToStation-b.timeToStation);
$('arrivalContent').innerHTML='';

if(!arr.length){
$('arrivalContent').textContent='Nenhuma previsão disponível.';
return;
}

arr.slice(0,35).forEach(a=>{
const div=document.createElement('div');
div.className='arrival';

const mins=Math.max(0,Math.floor(a.timeToStation/60));

div.textContent=
(a.lineName||'Serviço')+' → '+
(a.destinationName||'Destino não informado')+' • '+
(mins===0?'Chegando':mins+' min');

$('arrivalContent').append(div);
});

}catch(e){
$('arrivalContent').textContent='Previsões indisponíveis.';
}
}

function closeModal(){
$('arrivalModal').classList.remove('show');
}

async function planJourney(){
const from=$('from').value.trim();
const to=$('to').value.trim();

if(!from||!to){
$('journeyResult').textContent='Digite origem e destino.';
return;
}

$('journeyResult').textContent='Calculando...';

try{
const data=await api(
'/Journey/JourneyResults/'+encodeURIComponent(from)+'/to/'+encodeURIComponent(to)
);

const root=$('journeyResult');
root.innerHTML='';

(data.journeys||[]).slice(0,5).forEach((j,i)=>{
const box=document.createElement('div');
box.className='arrival';

const title=document.createElement('strong');
title.textContent='Opção '+(i+1)+' • '+j.duration+' minutos';
box.append(title);

(j.legs||[]).forEach(leg=>{
const p=document.createElement('p');
p.textContent=
(leg.mode?.name||'Trecho')+': '+
(leg.departurePoint?.commonName||'?')+' → '+
(leg.arrivalPoint?.commonName||'?');
box.append(p);
});

root.append(box);
});

if(!(data.journeys||[]).length){
root.textContent='Nenhuma opção encontrada.';
}

}catch(e){
$('journeyResult').textContent='Planejamento indisponível agora.';
}
}

function exportLon(){
const payload={
format:'LON',
version:1,
city:'London',
createdAt:new Date().toISOString(),
history
};

const blob=new Blob(
[JSON.stringify(payload,null,2)],
{type:'application/json'}
);

const url=URL.createObjectURL(blob);
const a=document.createElement('a');

a.href=url;
a.download='meu-transporte-londres.lon';
a.click();

URL.revokeObjectURL(url);
}

function importLon(ev){
const f=ev.target.files[0];
if(!f)return;

const reader=new FileReader();

reader.onload=()=>{
try{
const d=JSON.parse(reader.result);

if(d.format!=='LON'||!d.history||typeof d.history!=='object'){
throw Error();
}

history={...history,...d.history};
saveHistory();
renderLines();

alert('Histórico importado!');

}catch(e){
alert('Arquivo .LON inválido ou incompatível.');
}

ev.target.value='';
};

reader.readAsText(f);
}

loadNetwork();
</script>
</body>
</html>
